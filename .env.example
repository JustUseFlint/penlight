# Copy to .env for local use. NEVER commit real values.
PORT=3100
# DATA_DIR=./data                # SQLite lives here (default ./data)
# APP_SECRET=                    # REQUIRED on hosted deployments: encrypts the saved LLM API key (openssl rand -hex 32)
# PERSIST_DATABASE_URL=          # postgres://… (free Neon/Supabase) -> durable snapshots on hosts with ephemeral disks
# PERSIST_INTERVAL_SEC=30
# LLM_PROVIDER=xai               # xai | openai | anthropic | custom   (optional; can also be set in Settings)
# LLM_API_KEY=
# LLM_MODEL=
# LLM_BASE_URL=
# PDF_LOW_MEMORY=1               # one PDF at a time, Chromium closed after each (small hosts)
# DISABLE_WHISPER=1              # no audio transcription fallback
# YTDLP_COOKIES=/path/cookies.txt   or   YTDLP_COOKIES_B64=<base64 cookies.txt>   (throwaway account; helps when YouTube bot-checks the host IP)
